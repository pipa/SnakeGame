{
  "name": "snake-game",
  "version": "2.0.0",
  "description": "A neon browser snake game in plain modern JavaScript. No build step.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Luis Matute",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "npx --yes serve@14 -l 5173 .",
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p jsconfig.json",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
